# Set the deployed canonical URL for sitemap/metadata, e.g. https://shop.example.com
NEXT_PUBLIC_SITE_URL=

# Server-side Supabase connection. Never prefix the service-role key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional comma-separated extra origins for approved admin/storefront browser calls.
PUBLIC_SITE_ORIGINS=

# Optional demo WhatsApp number (country code + digits).
NEXT_PUBLIC_WHATSAPP_NUMBER=
